---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Vora" description="That page does not exist on getvora.net.">
  <section class="section center">
    <div class="shell">
      <span class="eyebrow">404</span>
      <h1>That page isn&rsquo;t here</h1>
      <p class="lede">The link may be out of date, or the page may have moved.</p>
      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn--primary" href="/">Back to the home page</a>
        <a class="btn btn--ghost" href="/features">Features</a>
      </div>
    </div>
  </section>
</Base>
