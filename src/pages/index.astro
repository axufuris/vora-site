---
import Base from '../layouts/Base.astro';
import Feature from '../components/Feature.astro';
import Shot from '../components/Shot.astro';
import PlatformSwitch from '../components/PlatformSwitch.astro';

const repo = 'https://github.com/axufuris/VoraMediaServer';
const donate = 'https://paypal.me/axufuris';
---

<Base
  title="Vora — Your movies, shows, music and live TV on every screen"
  description="Vora is a free, open-source media app for your own library. Movies and shows with cinematic detail pages, music with synced lyrics, podcasts, internet radio, and live TV with a real guide — on the web, your Android phone, your TV, and in the car."
>
  <section class="hero">
    <div class="shell">
      <span class="hero__badge">
        <b>Beta</b> · Free and open source · Your library, your server
      </span>

      <h1>
        Your movies, shows and music,<br />
        <span class="gradient-text">on every screen you own.</span>
      </h1>

      <p class="lede">
        Vora turns your media collection into something that feels like a streaming service — cinematic
        artwork, cast and crew, synced lyrics, a real live-TV guide, and profiles for everyone in the
        house. It runs on the web, on Android phones, on your television, and on the dash of your car.
      </p>

      <div class="btn-row">
        <a class="btn btn--primary" href="/features">See what it does</a>
        <a class="btn btn--ghost" href="/apps">Every screen</a>
      </div>

      <p class="muted" style="margin-top: 1.6rem; max-width: 60ch;">
        Vora is in beta. It runs every day in real homes, but expect the occasional rough edge and
        keep your backups — <a href="/features#roadmap">here is what is coming next</a>.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <Shot
        src="web/home"
        frame="browser"
        url="https://vora.local"
        alt="The Vora home screen showing Continue Watching and Recently Released rows"
        eager={true}
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell">
      <div class="section-head center">
        <span class="eyebrow">One app</span>
        <h2>Everything you own, in one place</h2>
        <p class="lede">
          Film night, a podcast on the commute, the ball game, an album while you cook — Vora does not
          hand you off to a different app for each one.
        </p>
      </div>

      <div class="grid">
        <Feature title="Movies & shows" icon="film">
          Posters badged with resolution, HDR and audio format, ratings from TMDB and Rotten Tomatoes,
          full cast and crew, and episodes with their own stills and summaries.
        </Feature>
        <Feature title="Music" icon="music">
          Artists, albums and playlists with a full-screen player, time-synced lyrics, a visible queue,
          crossfade and an equalizer.
        </Feature>
        <Feature title="Podcasts" icon="cast">
          Search, subscribe, and pick up each episode where you left it — on whichever device is nearest.
        </Feature>
        <Feature title="Live TV" icon="tv">
          A real channel guide with categories, favourites, a live preview window, and recording from
          inside the player.
        </Feature>
        <Feature title="Internet radio" icon="bolt">
          Thousands of stations, your favourites pinned, and skip-to-next-station from the player or the
          steering wheel.
        </Feature>
        <Feature title="Something to watch" icon="search">
          Discover pulls from TMDB and friends, For You surfaces the good things already sitting unwatched
          in your library, and a calendar tells you what lands next.
        </Feature>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="spotlight">
        <div class="spotlight__body">
          <span class="eyebrow">Detail pages</span>
          <h3>Every title, properly dressed</h3>
          <p>
            Artwork fills the page, the cast is a scrollable rail with character names, and every episode
            carries its own still, air date and summary. Play, add to watchlist, or mark it watched
            without leaving the page.
          </p>
        </div>
        <Shot
          src="web/show-season"
          url="vora.local/shows"
          alt="A season page with cinematic backdrop, cast rail and episode list"
        />
      </div>

      <div class="spotlight spotlight--reverse">
        <div class="spotlight__body">
          <span class="eyebrow">Live TV</span>
          <h3>A guide that behaves like a guide</h3>
          <p>
            Filter by category, region or resolution, star the channels you actually watch, and preview
            what is on without leaving the grid. Start recording an episode or a whole series from the
            player.
          </p>
        </div>
        <Shot
          src="web/live-tv-guide"
          url="vora.local/live"
          alt="The Vora live TV guide with a preview window, category filters and a channel grid"
        />
      </div>

      <div class="spotlight">
        <div class="spotlight__body">
          <span class="eyebrow">Music</span>
          <h3>With the words, in time</h3>
          <p>
            The full-screen player pulls its colour from the album art and scrolls lyrics line by line as
            the track plays. Queue, shuffle, repeat, like, and per-device audio settings are one tap away.
          </p>
        </div>
        <Shot
          src="web/music-player-with-lyrics"
          url="vora.local/music"
          alt="The Vora music player showing synced lyrics over an art-tinted background"
        />
      </div>

      <div class="spotlight spotlight--reverse">
        <div class="spotlight__body">
          <span class="eyebrow">For You</span>
          <h3>The good stuff you forgot you had</h3>
          <p>
            Rows like &ldquo;Because you like Animation&rdquo; dig out the highest-rated things in your own
            library that you have never started — so a big collection stops being a wall of posters you
            scroll past.
          </p>
        </div>
        <Shot
          src="web/library-for-you"
          url="vora.local/library"
          alt="A library page with For You recommendation rows drawn from the user's own collection"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head center">
        <span class="eyebrow">Streaming</span>
        <h2>It plays. That is the whole trick.</h2>
        <p class="lede">
          The reason a self-hosted library feels bad is usually not the library — it is the
          buffering, the audio that will not decode, the 4K file that melts the server. Vora spends most
          of its engineering effort here.
        </p>
      </div>

      <div class="paths">
        <div class="path">
          <span class="path__label">Best case</span>
          <h3>Direct play</h3>
          <p>
            Your device already speaks the container, the video codec and the audio codec. The file is
            handed over untouched and the server barely wakes up.
          </p>
        </div>
        <div class="path">
          <span class="path__label">Next best</span>
          <h3>Remux</h3>
          <p>
            The codecs are fine but the container is not. Vora repackages the stream into MP4 without
            re-encoding a single frame — cheap, fast, lossless.
          </p>
        </div>
        <div class="path">
          <span class="path__label">Last resort</span>
          <h3>Transcode</h3>
          <p>
            Only when something genuinely cannot be played — an unsupported codec, a burned-in subtitle,
            a bitrate your connection will not carry — and then on the GPU where one is available.
          </p>
        </div>
      </div>

      <div class="spotlight" style="margin-top: clamp(3rem, 7vw, 5rem); grid-template-columns: 1fr;">
        <div class="spotlight__body" style="max-width: 74ch;">
          <h3>Your device tells the server what it can do</h3>
          <p>
            On every play, the client probes its own hardware — which video and audio codecs actually
            decode, which containers it accepts, how many audio channels are available, whether the
            display can render HDR10, HLG or Dolby Vision, whether the decoder handles 10-bit — and sends
            that with the request. On Android TV it also detects when an AV receiver can bitstream
            AC3, E-AC3 or DTS, so surround is passed through instead of being flattened to stereo.
          </p>
          <p>
            The server then scores every combination of file and audio track it has for that title and
            picks the cheapest one that will actually play. A 4K remux with a 7.1 track and a 1080p copy
            with stereo are weighed against each other rather than guessed at — and it can copy the video
            while transcoding only the audio, instead of re-encoding the whole thing because one track
            was wrong.
          </p>
          <p class="note">
            Every decision is written down. The admin Watch History shows what each session chose, why,
            and what the runners-up scored — so &ldquo;why did that transcode?&rdquo; has an answer
            instead of a shrug.
          </p>
          <div class="btn-row">
            <a class="btn btn--ghost" href="/features#streaming">How playback is decided</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell">
      <div class="section-head center">
        <span class="eyebrow">Every screen</span>
        <h2>The same library, wherever you are</h2>
        <p class="lede">
          One Android app reshapes itself for a phone, a television and a car. Nothing is a stretched
          tablet layout, and nothing important is missing from the small screen. Android is out first —
          Roku, Apple TV and Fire TV clients are being built behind it.
        </p>
      </div>

      <PlatformSwitch name="home-shot" label="Home" web="web/home" phone="phone/home" tv="tv/home" />

      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn--ghost" href="/apps">Tour every platform</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="spotlight">
        <div class="spotlight__body">
          <span class="eyebrow">Profiles</span>
          <h3>Built for a household, not a person</h3>
          <p>
            Every profile gets its own watch state, recommendations and layout. Parental controls set
            allowed ratings per media type, hide unrated titles, and limit which libraries and channels a
            profile can reach — with scheduled access windows for the ones who would otherwise watch
            until 2am.
          </p>
        </div>
        <Shot
          src="web/profile-parental-controls"
          url="vora.local/settings"
          alt="The profile editor open on the Parental Controls tab with per-rating toggles"
        />
      </div>

      <div class="spotlight spotlight--reverse">
        <div class="spotlight__body">
          <span class="eyebrow">Collections</span>
          <h3>Name a universe, get the collection</h3>
          <p>
            Type &ldquo;Every movie and show for Marvel Cinematic Universe&rdquo; and Vora assembles it —
            every film, every season — then keeps it current and can sort it into in-universe
            chronological order rather than release order. Optional, uses your own OpenAI key, and every
            token it spends is itemised.
          </p>
          <div class="btn-row">
            <a class="btn btn--ghost" href="/features#ai">How the AI features work</a>
          </div>
        </div>
        <Shot
          src="web/ai-collection-list-filler"
          frame="plain"
          alt="The collection editor filling a collection from a franchise named in plain language"
        />
      </div>

      <div class="spotlight">
        <div class="spotlight__body">
          <span class="eyebrow">Make it yours</span>
          <h3>Rearrange it, then repaint it</h3>
          <p>
            Choose which rows appear on Home and in what order, reorder the navigation, and switch the
            whole client to a different visual template — colours, type and all — per profile.
          </p>
        </div>
        <Shot
          src="web/client-templates"
          url="vora.local/settings"
          alt="The client template picker showing alternative visual themes"
        />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell">
      <div class="section-head center">
        <span class="eyebrow">Where next</span>
        <h2>Two doors from here</h2>
      </div>

      <div class="doors">
        <a class="door" href="/features">
          <h3>What the app can do</h3>
          <p>
            The full tour — library and playback, discovery, live TV and DVR, music and podcasts,
            collections, playlists, profiles and themes.
          </p>
          <span>Explore the features &rarr;</span>
        </a>

        <a class="door" href="/server">
          <h3>Running your own server</h3>
          <p>
            The administration side — libraries and scanning, plugins, IPTV, transcoding, backups, a Plex
            importer, and what it takes to deploy.
          </p>
          <span>Server &amp; administration &rarr;</span>
        </a>
      </div>

      <div class="cta-band" style="margin-top: 2.5rem;">
        <h2 style="font-size: clamp(1.4rem, 2.6vw, 1.9rem);">Free, and staying that way</h2>
        <p class="lede center">
          Vora is one person's project, released under the AGPL-3.0. There is no paid tier, no account to
          make and nothing held back — if it saves you a subscription, that is the point. If you would
          like to put something toward the time it takes, that is genuinely appreciated and never
          expected.
        </p>
        <div class="btn-row" style="justify-content: center;">
          <a class="btn btn--primary" href={donate} rel="noopener">Buy me a coffee</a>
          <a class="btn btn--ghost" href={repo} rel="noopener">Read the source</a>
        </div>
      </div>
    </div>
  </section>
</Base>
