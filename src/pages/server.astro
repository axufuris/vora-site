---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Feature from '../components/Feature.astro';

const repo = 'https://github.com/axufuris/VoraMediaServer';

const providers = [
  ['Metadata', 'TMDB, TVDB, OMDb / IMDb ratings, local NFO and image assets'],
  ['Artwork', 'TMDB, TVDB, Fanart.tv, MediUX, TheAudioDB, MusicBrainz, MyAnimeList, local assets'],
  ['Discovery', 'TMDB Discovery, MyAnimeList Discovery, iTunes podcasts'],
  ['Lists & chronology', 'Trakt.tv, MDbList, IMDb public lists, AI franchise ordering'],
  ['Music', 'Last.fm scrobbling, Genius and LRClib lyrics'],
  ['Requests', 'Radarr and Sonarr requesters plus release calendars'],
  ['Subtitles', 'OpenSubtitles search with API-key or account authentication'],
  ['Extras', 'SerpApi showtimes, OpenAI smart recommendations, native poster overlays'],
];
---

<Base
  title="Server & administration — Vora"
  description="The administration side of Vora: libraries and scanning, metadata and artwork plugins, IPTV setup, poster overlays, deduplication, backups, a Plex importer, hardware transcoding and the architecture underneath."
>
  <section class="section section--tight">
    <div class="shell">
      <span class="eyebrow">Server</span>
      <h1 style="font-size: clamp(2rem, 5vw, 3.2rem);">The half nobody should have to think about</h1>
      <p class="lede">
        Vora is one Docker container holding a .NET API, the built web client, FFmpeg and Comskip. It
        scans your files, enriches them from whichever providers you enable, analyzes them for chapter
        markers, transcodes on demand, and records live television — then gets out of the way.
      </p>

      <div class="btn-row">
        <a class="btn btn--primary" href="/install">Installation guide</a>
        <a class="btn btn--ghost" href={`${repo}/tree/main/docs`} rel="noopener">Architecture docs</a>
      </div>

      <p class="muted" style="margin-top: 1.6rem; max-width: 62ch;">
        Vora is in beta. The schema migrates itself on every upgrade and backups are built in, but treat
        it as software that is still moving — keep a copy of your data volume.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <Shot
        src="admin/dashboard"
        url="vora.local/admin"
        alt="The Vora admin dashboard showing live streams, CPU, memory, bandwidth and library status"
        caption="Live activity, system health and every library at a glance — refreshed over SignalR, not on a page reload"
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell">
      <div class="spotlight">
        <div class="spotlight__body">
          <span class="pill">Libraries</span>
          <h3 style="margin-top: 1rem;">Point it at a folder and leave</h3>
          <p>
            Libraries scan in parallel, unit by unit, with live per-item progress. A watcher picks up new
            files as they appear, exclude filters keep samples and extras out, and multiple files for one
            title become selectable editions rather than duplicate entries. Anything you correct by hand
            can be locked so the next refresh leaves it alone.
          </p>
        </div>
        <Shot src="admin/library-management" url="vora.local/admin" alt="Library management in the Vora admin" />
      </div>

      <div class="spotlight spotlight--reverse">
        <div class="spotlight__body">
          <span class="pill">Plugins</span>
          <h3 style="margin-top: 1rem;">Bring your own providers</h3>
          <p>
            Every external integration is a plugin with its own settings page. API keys can be seeded
            from environment variables at startup, so a fresh deployment comes up already configured —
            and anything you later change in the UI wins from then on.
          </p>
        </div>
        <Shot src="admin/plugin-system" url="vora.local/admin" alt="The plugin list in the Vora admin" />
      </div>

      <div class="table-wrap" style="margin-top: 3rem;">
        <table>
          <thead><tr><th>Category</th><th>Bundled providers</th></tr></thead>
          <tbody>
            {providers.map(([category, list]) => (
              <tr>
                <td style="color: var(--text-primary); font-weight: 600;">{category}</td>
                <td>{list}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Live TV</span>
        <h2>Playlists in, guide out</h2>
        <p class="lede">
          IPTV playlists and EPG sources are configured independently, so one guide can cover several
          providers and one provider can feed several playlists. Internet radio is set up the same way.
        </p>
      </div>

      <div class="gallery">
        <Shot src="admin/iptv-setup" url="vora.local/admin" alt="IPTV playlist and EPG configuration" caption="IPTV playlists and EPG sources" />
        <Shot src="admin/internet-radio-setup" url="vora.local/admin" alt="Internet radio station configuration" caption="Internet radio" />
      </div>
    </div>
  </section>

  <section class="section section--alt" id="requests">
    <div class="shell">
      <div class="spotlight spotlight--wide">
        <div class="spotlight__body" style="max-width: 74ch;">
          <span class="pill">Requests</span>
          <h3 style="margin-top: 1rem;">Watchlists that turn into downloads</h3>
          <p>
            Connect Radarr and Sonarr under Request Servers — host, API key, quality profile, root folder,
            minimum availability — and a viewer adding something to their watchlist that you do not own
            becomes a request. No separate request app for your household to learn.
          </p>
          <p>
            Per user you decide whether they can request at all and whether their requests auto-approve.
            Everything else lands in the <strong>Request Queue</strong>, split into Pending, Processing and
            Available, where you can override the quality profile before sending it on. Requests for the
            same title merge, and when the file finally arrives and matches, the requesters get an email.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="plex">
    <div class="shell">
      <div class="spotlight">
        <div class="spotlight__body">
          <span class="pill">Coming from Plex</span>
          <h3 style="margin-top: 1rem;">Bring your history with you</h3>
          <p>
            The importer reads an existing Plex install and carries across the thing that actually hurts
            to lose: watch state and ratings. Switching does not mean starting every show from episode
            one again.
          </p>
          <p>
            It is not an admin-only migration, either. Every profile can run it themselves from
            <strong>Account settings &rarr; Connections &rarr; Import from Plex</strong> — link the Plex
            account with a PIN, choose which libraries to pull, and their own history comes across into
            their own profile. So the rest of the household can move their viewing history over without
            handing you their Plex password, and without waiting for you to do it for them.
          </p>
          <p class="muted">
            Administrators keep the bulk path under Library Migration, which maps several Plex accounts
            onto several Vora profiles in one run. Either way it is watch state and ratings — media,
            playlists and collections stay where they are.
          </p>
        </div>
        <Shot src="admin/plex-import" url="vora.local/admin" alt="The Plex import tool in the Vora admin" />
      </div>
    </div>
  </section>

  <section class="section" id="streaming">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Streaming</span>
        <h2>Deciding what to send, and to whom</h2>
        <p class="lede">
          Clients report their own decoder capabilities on every play. The server scores each copy of a
          title against them and takes the cheapest path that will actually work.
          <a href="/features#streaming">The viewer-facing version of this is on the features page.</a>
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead><tr><th>Transcoder behaviour priority</th><th>What it changes</th></tr></thead>
          <tbody>
            <tr>
              <td style="color: var(--text-primary); font-weight: 600;">Client Preference</td>
              <td>The default. Transcodes when something genuinely needs it, with no thumb on the scale.</td>
            </tr>
            <tr>
              <td style="color: var(--text-primary); font-weight: 600;">Direct Stream Preference</td>
              <td>
                Weights the scoring so heavily against transcoding that any playable copy wins. Best
                where CPU or GPU headroom is the scarce resource.
              </td>
            </tr>
            <tr>
              <td style="color: var(--text-primary); font-weight: 600;">Bandwidth Optimized</td>
              <td>
                Trades picture for upload. Penalises high-bitrate and 4K sources and caps delivery to a
                bitrate ceiling per resolution. The one profile that changes the output itself.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="grid" style="margin-top: 3rem;">
        <Feature title="Hardware acceleration" icon="bolt">
          NVENC and NVDEC with CUDA tone mapping, separate concurrency limits for GPU, CPU and background
          transcodes, and a choice of tone-mapping algorithm.
        </Feature>
        <Feature title="Remote bandwidth limits" icon="sliders">
          Cap remote streams by bitrate and declare your upload speed; the ceiling adjusts as other remote
          sessions come and go. Local playback is left alone.
        </Feature>
        <Feature title="A visible decision log" icon="search">
          Watch History records the chosen strategy and every runner-up with its score and reason, filtered
          by Direct Play, Direct Stream or Transcode. &ldquo;Why did that transcode?&rdquo; has an answer.
        </Feature>
        <Feature title="Honest badges" icon="shield">
          What was actually delivered is stored separately from what the file contains, so the dashboard
          never reports 4K HDR to someone being served 1080p SDR.
        </Feature>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Housekeeping</span>
        <h2>The unglamorous, necessary things</h2>
      </div>

      <div class="grid">
        <Feature title="Deduplication" icon="grid">
          Find the same title sitting on disk three times and decide what to keep, with the quality of
          each copy spelled out.
        </Feature>
        <Feature title="Media trash" icon="shield">
          A missing file is hidden rather than deleted, and per-profile ratings and watch state are
          preserved so a re-add restores them.
        </Feature>
        <Feature title="Backups" icon="clock">
          Scheduled zip backups with retention, restored atomically — a failed restore leaves nothing
          half-applied.
        </Feature>
        <Feature title="Smart lists" icon="sliders">
          Server-wide rule-based rows that feed everyone's home screen without anyone curating them.
        </Feature>
        <Feature title="Poster overlays" icon="film">
          Burn resolution, HDR and audio-format badges onto posters on a schedule, resolved from the best
          copy you have.
        </Feature>
        <Feature title="Logs & tasks" icon="search">
          A live log tail with runtime level overrides, and a task queue with real progress and per-task
          cancellation.
        </Feature>
      </div>

      <div class="gallery gallery--two" style="margin-top: 3rem;">
        <Shot src="admin/duplicate-file-management" url="vora.local/admin" alt="Duplicate file management" caption="Deduplication" />
        <Shot src="admin/backups" url="vora.local/admin" alt="Backup and restore" caption="Backup & restore" />
        <Shot src="admin/smart-list-management" url="vora.local/admin" alt="Smart list management" caption="Smart lists" />
        <Shot src="admin/poster-overlay-engine" url="vora.local/admin" alt="The poster overlay engine" caption="Poster overlays" />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell">
      <div class="spotlight">
        <div class="spotlight__body">
          <span class="pill">Appearance</span>
          <h3 style="margin-top: 1rem;">Set the look for everyone</h3>
          <p>
            Client templates are managed server-side: pick the default look, schedule seasonal ones by
            date range, and let each profile override it if they want to.
          </p>
        </div>
        <Shot src="admin/client-theming" url="vora.local/admin" alt="Client theming in the Vora admin" />
      </div>

      <div class="spotlight spotlight--reverse">
        <div class="spotlight__body">
          <span class="pill">AI usage</span>
          <h3 style="margin-top: 1rem;">Optional, and accounted for</h3>
          <p>
            Three features can call a model: filling a collection from a named franchise, ordering one
            chronologically, and embedding the library for recommendations. All three are off until you
            enable them and supply your own OpenAI key.
          </p>
          <p>
            Every call is logged with its feature, the profile that triggered it, the model, prompt and
            completion tokens and an estimated cost, filterable by date range or feature. Embeddings can
            be generated on demand rather than waiting for the schedule.
          </p>
          <div class="btn-row">
            <a class="btn btn--ghost" href="/features#ai">What the AI features do</a>
          </div>
        </div>
        <Shot src="admin/ai-usage" url="vora.local/admin" alt="AI usage and statistics" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Under the hood</span>
        <h2>What it is made of</h2>
      </div>

      <div class="grid">
        <Feature title=".NET 10 + PostgreSQL" icon="bolt">
          Minimal APIs over PostgreSQL with the <code>vector</code> extension, EF Core migrations applied
          automatically on startup, and SignalR for live updates.
        </Feature>
        <Feature title="Hardware transcoding" icon="film">
          FFmpeg in the container with NVENC, NVDEC and CUDA HDR-to-SDR tone mapping working out of the
          box on any host running the NVIDIA Container Toolkit.
        </Feature>
        <Feature title="Subtitles done properly" icon="search">
          Image subtitles burn in; text subtitles extract to a content-keyed cache warmed after a scan,
          never on the play path. OpenSubtitles search is one click from the player.
        </Feature>
        <Feature title="Chapter analysis" icon="clock">
          Silence and black-frame detection clustered across a whole season produces intro, recap,
          preview and credits markers — with a manual editor when it guesses wrong.
        </Feature>
        <Feature title="One tuner budget" icon="tv">
          Live, timeshift and DVR all draw from the same concurrent-stream limit, so nothing quietly
          steals a tuner mid-recording.
        </Feature>
        <Feature title="Devices & access" icon="users">
          Every client identifies itself, authorized devices can be revoked, and permission changes take
          effect live rather than at the next sign-in.
        </Feature>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell">
      <div class="cta-band">
        <h2>Two containers, five minutes</h2>
        <p class="lede center" style="margin-bottom: 0;">
          Postgres with <code>pgvector</code>, the Vora image, your media mounted read-only. It migrates
          its own schema on every upgrade.
        </p>
        <div class="btn-row" style="justify-content: center;">
          <a class="btn btn--primary" href="/install">Installation guide</a>
          <a class="btn btn--ghost" href={repo} rel="noopener">Browse the source</a>
        </div>
      </div>
    </div>
  </section>
</Base>
