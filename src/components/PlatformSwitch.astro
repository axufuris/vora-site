---
import Shot from './Shot.astro';

interface Props {
  name: string;
  web: string;
  phone: string;
  tv: string;
  iphone: string;
  ipad: string;
  appletv: string;
  label: string;
}

const { name, web, phone, tv, iphone, ipad, appletv, label } = Astro.props;
---

<div class="switcher">
  <div class="switcher__tabs" role="group" aria-label={`${label} on each platform`}>
    <input type="radio" name={name} id={`${name}-web`} checked />
    <label for={`${name}-web`}>Web</label>
    <input type="radio" name={name} id={`${name}-phone`} />
    <label for={`${name}-phone`}>Android phone</label>
    <input type="radio" name={name} id={`${name}-tv`} />
    <label for={`${name}-tv`}>Android TV</label>
    <input type="radio" name={name} id={`${name}-iphone`} />
    <label for={`${name}-iphone`}>iPhone</label>
    <input type="radio" name={name} id={`${name}-ipad`} />
    <label for={`${name}-ipad`}>iPad</label>
    <input type="radio" name={name} id={`${name}-appletv`} />
    <label for={`${name}-appletv`}>Apple TV</label>

    <div class="switcher__panels">
      <div class="switcher__panel switcher__panel--web">
        <Shot src={web} frame="browser" alt={`${label} in the Vora web client`} />
      </div>
      <div class="switcher__panel switcher__panel--phone">
        <Shot src={phone} frame="phone" alt={`${label} on an Android phone`} />
      </div>
      <div class="switcher__panel switcher__panel--tv">
        <Shot src={tv} frame="tv" alt={`${label} on Android TV`} />
      </div>
      <div class="switcher__panel switcher__panel--iphone">
        <Shot src={iphone} frame="phone" alt={`${label} on an iPhone`} />
      </div>
      <div class="switcher__panel switcher__panel--ipad">
        <Shot src={ipad} frame="tablet" alt={`${label} on an iPad`} />
      </div>
      <div class="switcher__panel switcher__panel--appletv">
        <Shot src={appletv} frame="tv" alt={`${label} on Apple TV`} />
      </div>
    </div>
  </div>
</div>
