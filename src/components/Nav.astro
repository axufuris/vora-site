---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/features', label: 'Features' },
  { href: '/apps', label: 'Every screen' },
  { href: '/server', label: 'Server' },
];
const repo = 'https://github.com/axufuris/VoraMediaServer';
---

<header class="nav">
  <div class="shell nav__inner">
    <a class="nav__brand" href="/">
      <img src="/vora-mark.svg" alt="" width="26" height="26" />
      <span>Vora</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
      <a class="nav__hide-sm" href={repo} rel="noopener">GitHub</a>
    </nav>

    <a class="btn btn--primary nav__cta" href="/install">Install</a>
  </div>
</header>
