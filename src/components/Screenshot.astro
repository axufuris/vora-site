---
interface Props {
  kind: 'browser' | 'phone' | 'tv' | 'car';
  src: string;
  alt: string;
  caption?: string;
  url?: string;
  width: number;
  height: number;
}

const { kind, src, alt, caption, url = 'vora.home.lan', width, height } = Astro.props;
---

<figure class="frame" style="margin: 0;">
  {kind === 'browser' && (
    <div class="frame__browser">
      <div class="frame__bar">
        <span class="frame__dot"></span>
        <span class="frame__dot"></span>
        <span class="frame__dot"></span>
        <span class="frame__url">{url}</span>
      </div>
      <img class="shot" src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </div>
  )}

  {kind === 'phone' && (
    <div class="frame__phone">
      <img class="shot" src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </div>
  )}

  {kind === 'tv' && (
    <div>
      <div class="frame__tv">
        <img class="shot" src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      </div>
      <div class="frame__tv-stand"></div>
    </div>
  )}

  {kind === 'car' && (
    <div class="frame__car">
      <img class="shot" src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </div>
  )}

  {caption && <figcaption>{caption}</figcaption>}
</figure>
